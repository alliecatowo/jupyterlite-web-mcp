{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm --prefix packages/jupyterlite-webmcp ci",
  "buildCommand": "./scripts/build-site.sh",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "credentialless"
        }
      ]
    },
    {
      "source": "/service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/(.*\\.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/jupyter-lite.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "ignoreCommand": "case \"$VERCEL_GIT_COMMIT_REF\" in main|preview/*) exit 1 ;; *) exit 0 ;; esac",
  "redirects": [
    {
      "source": "/",
      "destination": "/lab/index.html?path=customer-analysis.ipynb",
      "permanent": false
    },
    {
      "source": "/lab/index.html",
      "missing": [
        {
          "type": "query",
          "key": "path"
        },
        {
          "type": "query",
          "key": "reset"
        }
      ],
      "destination": "/lab/index.html?path=customer-analysis.ipynb",
      "permanent": false
    }
  ]
}
