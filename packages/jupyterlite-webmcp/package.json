{
  "name": "jupyterlite-webmcp",
  "version": "0.1.0",
  "description": "Expose the live JupyterLite workspace to a compatible browser agent through WebMCP.",
  "keywords": [
    "jupyter",
    "jupyterlab",
    "jupyterlab-extension",
    "jupyterlite",
    "webmcp"
  ],
  "homepage": "https://github.com/allisoncoleman/jupyterlite-web-mcp",
  "bugs": {
    "url": "https://github.com/allisoncoleman/jupyterlite-web-mcp/issues"
  },
  "license": "MIT",
  "author": "Allison Coleman",
  "files": [
    "lib/**/*.{d.ts,js,js.map,json}",
    "style/**/*.{css,js}",
    "src/**/*.{ts,tsx}"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "style": "style/index.css",
  "styleModule": "style/index.js",
  "sideEffects": [
    "style/*.css",
    "style/index.js"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/allisoncoleman/jupyterlite-web-mcp.git"
  },
  "scripts": {
    "build": "npm run build:lib && npm run build:labextension:dev",
    "build:prod": "npm run clean && npm run build:lib:prod && npm run build:labextension",
    "build:labextension": "jupyter-builder build .",
    "build:labextension:dev": "jupyter-builder build --development True .",
    "build:lib": "tsc --sourceMap",
    "build:lib:prod": "tsc",
    "clean": "npm run clean:lib",
    "clean:lib": "rimraf lib tsconfig.tsbuildinfo",
    "clean:labextension": "rimraf jupyterlite_webmcp/labextension jupyterlite_webmcp/_version.py",
    "clean:all": "npm run clean:lib && npm run clean:labextension",
    "install:extension": "npm run build",
    "test": "jest",
    "test:cov": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "watch": "tsc -w --sourceMap"
  },
  "dependencies": {
    "@jupyterlab/application": "4.6.0",
    "@jupyterlab/apputils": "4.7.0",
    "@jupyterlab/cells": "4.6.0",
    "@jupyterlab/codeeditor": "4.6.0",
    "@jupyterlab/coreutils": "6.6.0",
    "@jupyterlab/docmanager": "4.6.0",
    "@jupyterlab/docregistry": "4.6.0",
    "@jupyterlab/filebrowser": "4.6.0",
    "@jupyterlab/nbformat": "4.6.0",
    "@jupyterlab/notebook": "4.6.0",
    "@jupyterlab/services": "7.6.0",
    "@jupyterlab/statusbar": "4.6.0",
    "@jupyterlab/ui-components": "4.6.0",
    "@lumino/coreutils": "2.2.2",
    "@lumino/disposable": "2.1.5",
    "@lumino/signaling": "2.1.5",
    "@lumino/widgets": "2.8.0",
    "react": "^18.2.0"
  },
  "overrides": {
    "@jupyter/builder": {
      "@jupyterlab/core-meta": "4.6.0"
    },
    "@lumino/coreutils": "2.2.2",
    "@lumino/disposable": "2.1.5",
    "@lumino/signaling": "2.1.5",
    "@lumino/widgets": "2.8.0"
  },
  "devDependencies": {
    "@jupyter/builder": "^1.2.2",
    "@types/jest": "^29.5.12",
    "@types/react": "^18.2.0",
    "jest": "^29.7.0",
    "rimraf": "^5.0.1",
    "ts-jest": "^29.1.2",
    "typescript": "~5.9.3",
    "webmcp-types": "^0.1.5"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "jupyterlite_webmcp/labextension"
  },
  "publishConfig": {
    "access": "public"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "none",
    "arrowParens": "avoid",
    "endOfLine": "auto"
  }
}
