{
  "name": "jupyterlite-webmcp",
  "version": "0.1.0",
  "description": "Expose the live JupyterLite workspace to a compatible browser agent through WebMCP.",
  "keywords": [
    "jupyter",
    "jupyterlab",
    "jupyterlab-extension",
    "jupyterlite",
    "webmcp"
  ],
  "homepage": "https://github.com/alliecatowo/jupyterlite-web-mcp",
  "bugs": {
    "url": "https://github.com/alliecatowo/jupyterlite-web-mcp/issues"
  },
  "license": "MIT",
  "author": "Allison Coleman <me@allisons.dev>",
  "contributors": [
    "Juan Mendoza"
  ],
  "files": [
    "lib/**/*.{d.ts,js,js.map,json}",
    "style/**/*.{css,js}",
    "src/**/*.{ts,tsx}"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "style": "style/index.css",
  "styleModule": "style/index.js",
  "sideEffects": [
    "style/*.css",
    "style/index.js"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/alliecatowo/jupyterlite-web-mcp.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:lib && npm run build:labextension:dev",
    "build:prod": "npm run clean && npm run build:lib:prod && npm run build:labextension",
    "build:labextension": "jupyter-builder build .",
    "build:labextension:dev": "jupyter-builder build --development True .",
    "build:lib": "tsc --sourceMap",
    "build:lib:prod": "tsc",
    "clean": "npm run clean:lib",
    "clean:lib": "rimraf lib tsconfig.tsbuildinfo",
    "clean:labextension": "rimraf jupyterlite_webmcp/labextension jupyterlite_webmcp/_version.py",
    "clean:all": "npm run clean:lib && npm run clean:labextension",
    "install:extension": "npm run build",
    "lint": "eslint src tests --fix && prettier --write \"tests/**/*.ts\"",
    "lint:check": "eslint src tests && prettier --check \"tests/**/*.ts\"",
    "test": "jest",
    "test:cov": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "watch": "tsc -w --sourceMap"
  },
  "dependencies": {
    "@jupyterlab/application": "^4.6.4",
    "@jupyterlab/apputils": "^4.7.0",
    "@jupyterlab/cells": "^4.6.4",
    "@jupyterlab/codeeditor": "^4.6.0",
    "@jupyterlab/docmanager": "^4.6.0",
    "@jupyterlab/filebrowser": "^4.6.0",
    "@jupyterlab/notebook": "^4.6.4",
    "@jupyterlab/services": "^7.6.0",
    "@jupyterlab/statusbar": "^4.6.0",
    "@jupyterlab/ui-components": "^4.6.0",
    "@lumino/coreutils": "^2.2.3",
    "@lumino/disposable": "^2.1.6",
    "@lumino/signaling": "^2.1.6",
    "@lumino/widgets": "^2.9.0",
    "react": "^18.2.0"
  },
  "overrides": {
    "@jupyter/builder": {
      "@jupyterlab/core-meta": "4.6.0"
    },
    "@lumino/coreutils": "$@lumino/coreutils",
    "@lumino/disposable": "$@lumino/disposable",
    "@lumino/signaling": "$@lumino/signaling",
    "@lumino/widgets": "$@lumino/widgets"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@jupyter/builder": "^1.2.3",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.2.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.5.2",
    "jest-util": "^30.5.1",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.14",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.70.1",
    "webmcp-types": "^0.1.9"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "jupyterlite_webmcp/labextension"
  },
  "publishConfig": {
    "access": "public"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "none",
    "arrowParens": "avoid",
    "endOfLine": "auto"
  }
}
